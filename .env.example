# Test money only. Use a NEW wallet that has never held real funds.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
RAILGATE_PRIVATE_KEY=replace_with_testnet_only_private_key
# Generate each local secret independently: openssl rand -hex 32
APPROVAL_SECRET=replace_with_random_secret_at_least_32_characters
OWNER_API_TOKEN=replace_with_different_random_owner_secret
AGENT_API_TOKEN=replace_with_different_random_agent_secret
AGENT_ID=research-agent-07
# A trusted HTTPS URL that forwards to this server, reachable from your phone.
PUBLIC_BASE_URL=https://replace-with-your-approval-host.example
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace_with_private_random_topic
# Optional for a private/authenticated ntfy topic. Protect subscription access.
NTFY_TOKEN=
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/railgate.sqlite
POLICY_PATH=./policies/example.yaml

# MCP client settings (supply only these to the agent's MCP process):
RAILGATE_API_URL=http://127.0.0.1:3000
RAILGATE_AGENT_TOKEN=replace_with_same_value_as_AGENT_API_TOKEN
# Live overspend demo. Use a separate wallet you control as the merchant.
# The CLI binds DataCo in the owner catalog to this public address.
# Optional cooperative returns need DEMO_RECIPIENT_PRIVATE_KEY (generated by init:local)
# and Base Sepolia ETH on the recipient. Never use a mainnet key.
DEMO_RECIPIENT_ADDRESS=replace_with_testnet_recipient_address
# Keep this ID unchanged for retries. A new ID creates new payment intents.
DEMO_RUN_ID=first-demo
# Owner-maintained fictional test profiles. Agents cannot edit these over MCP/API.
COUNTERPARTY_PATH=./examples/counterparties.json
# Optional Wise SANDBOX quote access. Leave both empty for clearly labelled mocks.
# Use a sandbox-only token; never a production credential. No Wise transfer API is called.
WISE_SANDBOX_TOKEN=
WISE_SANDBOX_PROFILE_ID=

# Hosted backend verification only: 1 disables payment writes and the worker.
RAILGATE_READ_ONLY=0
# Set ONLY in the Vercel gateway project's settings, never copy wallet keys there:
# RAILGATE_BACKEND_ORIGIN=https://your-backend.onrender.com
