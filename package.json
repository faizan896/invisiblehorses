{
  "name": "railgate",
  "version": "0.1.0",
  "private": true,
  "description": "Policy-controlled testnet payments for AI agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "init:local": "tsx scripts/init-local.ts",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/src/cli.js serve",
    "mcp": "tsx src/cli.ts mcp",
    "setup:mcp": "node scripts/setup-mcp.mjs",
    "export:hosting": "node scripts/export-hosting.mjs",
    "build": "pnpm --filter payroute build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter payroute build && pnpm --filter payroute typecheck && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm --filter payroute build && vitest run && pnpm --filter payroute test",
    "test:watch": "vitest",
    "demo": "tsx examples/overspend-demo/live.ts",
    "demo:offline": "tsx examples/overspend-demo/offline.ts",
    "demo:record": "vhs examples/overspend-demo/railgate.tape",
    "demo:quotes": "tsx examples/quotes-demo.ts",
    "demo:routing": "tsx examples/routing-demo.ts",
    "demo:x402": "tsx examples/x402-server/demo.ts",
    "dev:playground": "pnpm --filter payroute dev",
    "build:playground": "pnpm --filter payroute build:playground && node scripts/stage-playground.mjs",
    "x402:server": "tsx examples/x402-server/serve.ts",
    "build:worker": "wrangler deploy --dry-run --outdir worker-dist/production",
    "test:worker": "pnpm build && wrangler deploy --config wrangler.test.jsonc --dry-run --outdir worker-dist/test && vitest run --config vitest.cloudflare.config.ts",
    "deploy:worker": "wrangler deploy",
    "export:cloudflare": "node scripts/export-cloudflare.mjs",
    "dev:console": "vite --config console/vite.config.ts",
    "build:console": "vite build --config console/vite.config.ts && node scripts/stage-console.mjs",
    "dev:console-worker": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --config wrangler.console.jsonc --port 8787 --var PUBLIC_ORIGIN:http://127.0.0.1:8788",
    "build:console-worker": "wrangler deploy --config wrangler.console.jsonc --dry-run --outdir worker-dist/console",
    "deploy:console-worker": "wrangler deploy --config wrangler.console.jsonc",
    "test:console-worker": "pnpm build:console-worker && vitest run --config vitest.console.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "better-sqlite3": "12.4.1",
    "dotenv": "^18.0.9",
    "hono": "4.13.13",
    "payroute": "workspace:*",
    "undici": "^6.29.1",
    "viem": "2.57.11",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@x402/hono": "2.28.0",
    "eslint": "^10.13.0",
    "miniflare": "4.20260730.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "4.0.18",
    "wrangler": "4.152.0"
  }
}
